# Security and caching headers for Cloudflare Pages (static files only; the
# Pages Functions in functions/ set their own headers).
#
# Content-Security-Policy allows only what the site uses:
#   - challenges.cloudflare.com: Turnstile on the contact form (script + iframe)
#   - www.google.com: the office map embed, if a map URL is set
#   - garibecho.com: the Gari Becho demo video
# 'unsafe-inline' in script-src is needed because Next.js static export
# inlines its page data and the theme script; nothing else runs inline.
# If you embed something new (video host, analytics), add its origin here.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.google.com; media-src 'self' https://garibecho.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), fullscreen=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Content manager (Decap CMS). Decap is loaded from unpkg (pinned, with an
# integrity hash), talks to the GitHub API, needs 'unsafe-eval' to check its
# config, and opens the GitHub login popup, so it can't use the site policy
# or Cross-Origin-Opener-Policy: same-origin.
/admin/*
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com https://unpkg.com; frame-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

# Hashed build files never change, so browsers can keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
