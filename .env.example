# Public build-time variables for Next.js. Copy to .env.local for local builds;
# in Cloudflare Pages, set them under Settings → Variables (build environment).
# NEXT_PUBLIC_ values are embedded in the browser bundle, so never put secrets here.

# Turnstile site key (Cloudflare dashboard → Turnstile → your widget).
# For local testing, Cloudflare's test site keys:
#   1x00000000000000000000AA  always passes (visible widget)
#   2x00000000000000000000AB  always blocks
#   3x00000000000000000000FF  forces an interactive challenge
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
