# Secrets for the contact form function (functions/api/contact.ts) when you
# run it locally with Wrangler. Copy this file to .dev.vars and fill it in:
#
#   cp .dev.vars.example .dev.vars
#
# .dev.vars is gitignored. Never commit real keys. In production, set these in
# Cloudflare: Workers & Pages → your project → Settings → Variables and Secrets
# (type "Secret" for the first three).

# Resend API key (https://resend.com/api-keys), starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Several addresses: separate with commas.
CONTACT_TO_EMAIL=you@example.com

# Turnstile secret key (Cloudflare dashboard → Turnstile → your widget).
# For local testing, Cloudflare's test secrets:
#   1x0000000000000000000000000000000AA  always passes
#   2x0000000000000000000000000000000AA  always fails
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional, not secret: the sender shown on the email. It must use a domain
# you have verified in Resend. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
